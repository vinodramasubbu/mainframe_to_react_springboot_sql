//TRSYRECN JOB (TRSY),'BANK RECONCILIATION',CLASS=A,MSGCLASS=X,
//             NOTIFY=&SYSUID,REGION=0M
//* VALIDATE BANK CONTROL TOTALS, STAGE DETAILS, THEN RECONCILE DB2.
//RECON    EXEC PGM=IKJEFT01,DYNAMNBR=20
//STEPLIB  DD DSN=DEV1.TRSYDEMO.LOAD,DISP=SHR
//         DD DSN=DB2T.SDSNLOAD,DISP=SHR
//SYSTSPRT DD SYSOUT=*
//SYSPRINT DD SYSOUT=*
//SYSOUT   DD SYSOUT=*
//SYSTSIN  DD *
  DSN SYSTEM(DB2T)
  RUN PROGRAM(BANKRECN) PLAN(TRSYPLAN) LIB('DEV1.TRSYDEMO.LOAD')
  END
