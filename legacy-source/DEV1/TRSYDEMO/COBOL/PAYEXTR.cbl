038100         FROM RECON-EXCEPTION-RECORD
038200
038300     EXEC SQL
038400         INSERT INTO TRSYDEMO.RECON_EXCEPTION
038500             (FILE_ID, PAYMENT_ID, EXCEPTION_CODE,
038600              EXPECTED_AMOUNT, ACTUAL_AMOUNT)
038700         VALUES
