007900     EXEC SQL
008000         DECLARE PAYCUR CURSOR FOR
008100         SELECT PAYMENT_ID,
008200                COMPANY_CODE,
008300                BENEFICIARY_ID,
008400                PAYMENT_METHOD,
008500                CURRENCY,
008600                AMOUNT,
008700                CHAR(EFFECTIVE_DATE, ISO),
008800                DEBIT_ACCOUNT,
008900                BENEFICIARY_NAME,
009000                BANK_ROUTING,
009100                BANK_ACCOUNT,
009200                BANK_COUNTRY,
009300                END_TO_END_ID,
009400                STATUS,
009500                BANK_TRACE,
009600                VERSION_NO
009700           FROM TRSYDEMO.PAYMENT_INSTRUCTION
009800          WHERE STATUS = 'A'
009900            AND EFFECTIVE_DATE <= DATE(:HV-RUN-DATE)
010000          ORDER BY COMPANY_CODE, PAYMENT_ID
010200          WITH RS USE AND KEEP UPDATE LOCKS
010300     END-EXEC.
