034200     WRITE DISBURSEMENT-FILE-RECORD
034300         FROM PAYMENT-OUTPUT-RECORD.
034400
034500 MARK-PAYMENT-SENT.
034600     ADD 1 TO WS-OUTPUT-COUNT GIVING HV-SEQUENCE-NO
034700     EXEC SQL
034800         UPDATE TRSYDEMO.PAYMENT_INSTRUCTION
034900            SET STATUS = 'S',
035000                VERSION_NO = VERSION_NO + 1,
035100                UPDATED_TS = CURRENT TIMESTAMP
035200          WHERE PAYMENT_ID = :HV-PAYMENT-ID
035300            AND STATUS = 'A'
