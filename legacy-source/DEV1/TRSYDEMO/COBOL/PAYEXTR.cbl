010800     IF WS-FATAL
010900         GO TO FINISH-PROGRAM
011000     END-IF
011100
011200     READ RUN-CONTROL
011300         AT END
011400             MOVE 12 TO WS-MAX-RC
011500             SET WS-FATAL TO TRUE
011600     END-READ
011700     IF WS-FATAL
011800         GO TO FINISH-PROGRAM
011900     END-IF
012000
012100     PERFORM FORMAT-RUN-CONTROL
012200     PERFORM START-BATCH
012300     IF WS-FATAL
012400         GO TO ROLLBACK-BATCH
012500     END-IF
012600
012700     PERFORM WRITE-HEADER
012800     EXEC SQL OPEN PAYCUR END-EXEC
012900     IF SQLCODE NOT = ZERO
013000         PERFORM SET-TECHNICAL-FAILURE
013100     END-IF
013200
013300     PERFORM UNTIL WS-END-OF-CURSOR OR WS-FATAL
013400         PERFORM FETCH-PAYMENT
013500         IF NOT WS-END-OF-CURSOR AND NOT WS-FATAL
013600             PERFORM PROCESS-PAYMENT
013700         END-IF
013800     END-PERFORM
