035500     END-EXEC
035600     IF SQLCODE NOT = ZERO OR SQLERRD(3) NOT = 1
035700         PERFORM SET-TECHNICAL-FAILURE
035800         EXIT PARAGRAPH
035900     END-IF
036000
036100     EXEC SQL
036200         INSERT INTO TRSYDEMO.DISBURSEMENT_ITEM
036300             (BATCH_ID, PAYMENT_ID, SEQUENCE_NO, AMOUNT)
036400         VALUES
036500             (:HV-BATCH-ID, :HV-PAYMENT-ID,
036600              :HV-SEQUENCE-NO, :HV-AMOUNT)
036700     END-EXEC
036800     IF SQLCODE NOT = ZERO
036900         PERFORM SET-TECHNICAL-FAILURE
037000     END-IF.
037100
037200 WRITE-PAYMENT-EXCEPTION.
