005400
005500 01  WS-TOTALS.
005600     05  WS-OUTPUT-COUNT            PIC 9(9) COMP-3 VALUE ZERO.
005700     05  WS-OUTPUT-TOTAL            PIC S9(13)V99 COMP-3 VALUE ZERO.
005800     05  WS-COMPANY-TOTAL           PIC S9(13)V99 COMP-3 VALUE ZERO.
005900     05  WS-COMPANY-LIMIT           PIC S9(13)V99 COMP-3 VALUE ZERO.
006000     05  WS-EXCEPTION-COUNT         PIC 9(9) COMP-3 VALUE ZERO.
006100     05  WS-MAX-RC                  PIC S9(4) COMP VALUE ZERO.
006200
006300     COPY PAYREC.
006400     COPY RECONEX.
006500
006600     EXEC SQL BEGIN DECLARE SECTION END-EXEC.
006700     COPY PAYHOST.
006800 01  DB2-CONTROL-HOSTS.
006900     05  HV-RUN-DATE                PIC X(10).
007000     05  HV-BATCH-ID               PIC X(12).
007100     05  HV-DAILY-LIMIT            PIC S9(13)V99 COMP-3.
007200     05  HV-OUTPUT-COUNT           PIC S9(9) COMP.
007300     05  HV-OUTPUT-TOTAL           PIC S9(13)V99 COMP-3.
007400     05  HV-SEQUENCE-NO            PIC S9(9) COMP.
007500     05  HV-EXCEPTION-CODE         PIC X(2).
007600     EXEC SQL END DECLARE SECTION END-EXEC.
007700     EXEC SQL INCLUDE SQLCA END-EXEC.
