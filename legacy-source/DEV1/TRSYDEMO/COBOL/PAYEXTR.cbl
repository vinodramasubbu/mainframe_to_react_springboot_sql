014000
014100     IF WS-FATAL
014200         GO TO ROLLBACK-BATCH
014300     END-IF
014400
014500     PERFORM WRITE-TRAILER
014600     PERFORM COMPLETE-BATCH
014700     IF WS-FATAL
014800         GO TO ROLLBACK-BATCH
014900     END-IF
015000     EXEC SQL COMMIT END-EXEC
015100     IF SQLCODE NOT = ZERO
015200         PERFORM SET-TECHNICAL-FAILURE
015300         GO TO ROLLBACK-BATCH
015400     END-IF
015500     GO TO FINISH-PROGRAM.
015600
015700 ROLLBACK-BATCH.
015800     EXEC SQL ROLLBACK END-EXEC
015900     MOVE 12 TO WS-MAX-RC.
016000
016100 FINISH-PROGRAM.
016200     PERFORM CLOSE-FILES
016300     DISPLAY 'PAYEXTR BATCH=' WS-BATCH-ID
016400             ' OUTPUT=' WS-OUTPUT-COUNT
016500             ' EXCEPTIONS=' WS-EXCEPTION-COUNT
016600     MOVE WS-MAX-RC TO RETURN-CODE
016700     GOBACK.
016800
016900 OPEN-FILES.
017000     OPEN INPUT RUN-CONTROL
017100          OUTPUT DISBURSEMENT-OUT EXCEPTION-OUT
017200     IF WS-RUNCTL-STATUS NOT = '00'
017300        OR WS-DISB-STATUS NOT = '00'
017400        OR WS-EXCEPT-STATUS NOT = '00'
017500         MOVE 12 TO WS-MAX-RC
017600         SET WS-FATAL TO TRUE
017700     END-IF.
017800
017900 CLOSE-FILES.
018000     CLOSE RUN-CONTROL DISBURSEMENT-OUT EXCEPTION-OUT.
018100
018200 FORMAT-RUN-CONTROL.
018300     MOVE RUN-BATCH-ID TO WS-BATCH-ID HV-BATCH-ID
018400     STRING
018500         RUN-VALUE-DATE(1:4) DELIMITED BY SIZE
018600         '-' DELIMITED BY SIZE
018700         RUN-VALUE-DATE(5:2) DELIMITED BY SIZE
018800         '-' DELIMITED BY SIZE
018900         RUN-VALUE-DATE(7:2) DELIMITED BY SIZE
019000         INTO WS-RUN-DATE-ISO
019100     END-STRING
019200     MOVE WS-RUN-DATE-ISO TO HV-RUN-DATE.
019300
019400 START-BATCH.
019500     EXEC SQL
019600         INSERT INTO TRSYDEMO.DISBURSEMENT_BATCH
019700             (BATCH_ID, VALUE_DATE, CURRENCY, PAYMENT_COUNT,
019800              PAYMENT_TOTAL, STATUS, FILE_NAME)
019900         VALUES
020000             (:HV-BATCH-ID, DATE(:HV-RUN-DATE), 'USD',
020100              0, 0, 'B', 'TRSY.DAILY.DISBURSE')
020200     END-EXEC
020300     IF SQLCODE NOT = ZERO
020400         PERFORM SET-TECHNICAL-FAILURE
020500     END-IF.
020600
020700 WRITE-HEADER.
020800     INITIALIZE PAYMENT-OUTPUT-RECORD
020900     SET PAY-HEADER-RECORD TO TRUE
021000     MOVE WS-BATCH-ID TO PAY-HDR-BATCH-ID
021100     MOVE RUN-VALUE-DATE TO PAY-HDR-VALUE-DATE
021200     MOVE 'USD' TO PAY-HDR-CURRENCY
021300     WRITE DISBURSEMENT-FILE-RECORD
021400         FROM PAYMENT-OUTPUT-RECORD.
021500
021600 FETCH-PAYMENT.
021700     MOVE -1 TO HV-BANK-TRACE-IND
021800     EXEC SQL
021900         FETCH PAYCUR
022000          INTO :HV-PAYMENT-ID,
022100               :HV-COMPANY-CODE,
022200               :HV-BENEFICIARY-ID,
022300               :HV-PAYMENT-METHOD,
022400               :HV-CURRENCY,
022500               :HV-AMOUNT,
022600               :HV-EFFECTIVE-DATE,
022700               :HV-DEBIT-ACCOUNT,
022800               :HV-BENEFICIARY-NAME,
022900               :HV-BANK-ROUTING,
023000               :HV-BANK-ACCOUNT,
023100               :HV-BANK-COUNTRY,
023200               :HV-END-TO-END-ID,
023300               :HV-PAYMENT-STATUS,
023400               :HV-BANK-TRACE :HV-BANK-TRACE-IND,
023500               :HV-VERSION-NO
023600     END-EXEC
023700     EVALUATE SQLCODE
023800         WHEN ZERO
023900             CONTINUE
024000         WHEN +100
024100             SET WS-END-OF-CURSOR TO TRUE
024200         WHEN OTHER
024300             PERFORM SET-TECHNICAL-FAILURE
024400     END-EVALUATE.
024500
024600 PROCESS-PAYMENT.
024700     PERFORM VALIDATE-PAYMENT
024800     IF WS-EXCEPTION-CODE NOT = SPACES
024900         PERFORM WRITE-PAYMENT-EXCEPTION
025000         EXIT PARAGRAPH
025100     END-IF
025200
025300     IF HV-COMPANY-CODE NOT = WS-CURRENT-COMPANY
025400         MOVE HV-COMPANY-CODE TO WS-CURRENT-COMPANY
025500         MOVE ZERO TO WS-COMPANY-TOTAL
025600         PERFORM LOAD-COMPANY-LIMIT
025700         IF WS-EXCEPTION-CODE NOT = SPACES
025800             PERFORM WRITE-PAYMENT-EXCEPTION
025900             EXIT PARAGRAPH
026000         END-IF
026100     END-IF
026200
026300     IF WS-COMPANY-TOTAL + HV-AMOUNT > WS-COMPANY-LIMIT
026400         MOVE 'L1' TO WS-EXCEPTION-CODE
026500         MOVE 'COMPANY DAILY LIMIT EXCEEDED'
026600           TO WS-EXCEPTION-TEXT
026700         PERFORM WRITE-PAYMENT-EXCEPTION
026800         EXIT PARAGRAPH
026900     END-IF
027000
027100     PERFORM WRITE-PAYMENT-DETAIL
027200     PERFORM MARK-PAYMENT-SENT
027300     IF WS-FATAL
027400         EXIT PARAGRAPH
027500     END-IF
027600
027700     ADD HV-AMOUNT TO WS-COMPANY-TOTAL
027800     ADD HV-AMOUNT TO WS-OUTPUT-TOTAL
027900     ADD 1 TO WS-OUTPUT-COUNT.
028000
028100 VALIDATE-PAYMENT.
028200     MOVE SPACES TO WS-EXCEPTION-CODE WS-EXCEPTION-TEXT
028300     EVALUATE TRUE
028400         WHEN HV-CURRENCY NOT = 'USD'
028500             MOVE 'C1' TO WS-EXCEPTION-CODE
028600             MOVE 'ONLY USD DISBURSEMENTS ARE SUPPORTED'
028700               TO WS-EXCEPTION-TEXT
028800         WHEN HV-AMOUNT <= ZERO
028900             MOVE 'A1' TO WS-EXCEPTION-CODE
029000             MOVE 'PAYMENT AMOUNT MUST BE POSITIVE'
029100               TO WS-EXCEPTION-TEXT
029200         WHEN HV-PAYMENT-METHOD NOT = 'ACH'
029300          AND HV-PAYMENT-METHOD NOT = 'WIR'
029400             MOVE 'M1' TO WS-EXCEPTION-CODE
029500             MOVE 'INVALID PAYMENT METHOD'
029600               TO WS-EXCEPTION-TEXT
029700         WHEN HV-BANK-ROUTING IS NOT NUMERIC
029800          OR HV-BANK-ACCOUNT = SPACES
029900             MOVE 'B1' TO WS-EXCEPTION-CODE
030000             MOVE 'INVALID BENEFICIARY BANK DETAILS'
030100               TO WS-EXCEPTION-TEXT
030200         WHEN OTHER
030300             CONTINUE
030400     END-EVALUATE.
030500
030600 LOAD-COMPANY-LIMIT.
030700     MOVE SPACES TO WS-EXCEPTION-CODE WS-EXCEPTION-TEXT
030800     EXEC SQL
030900         SELECT DAILY_LIMIT
031000           INTO :HV-DAILY-LIMIT
031100           FROM TRSYDEMO.COMPANY_LIMIT
031200          WHERE COMPANY_CODE = :HV-COMPANY-CODE
031300            AND CURRENCY = 'USD'
031400            AND STATUS = 'A'
031500          WITH CS
031600     END-EXEC
031700     IF SQLCODE = +100
031800         MOVE 'L0' TO WS-EXCEPTION-CODE
031900         MOVE 'ACTIVE COMPANY LIMIT NOT FOUND'
032000           TO WS-EXCEPTION-TEXT
032100     ELSE
032200         IF SQLCODE NOT = ZERO
032300             PERFORM SET-TECHNICAL-FAILURE
032400         ELSE
032500             MOVE HV-DAILY-LIMIT TO WS-COMPANY-LIMIT
032600         END-IF
032700     END-IF.
032800
032900 WRITE-PAYMENT-DETAIL.
033000     INITIALIZE PAYMENT-OUTPUT-RECORD
033100     SET PAY-DETAIL-RECORD TO TRUE
033200     MOVE HV-PAYMENT-ID TO PAY-DTL-PAYMENT-ID
033300     MOVE HV-COMPANY-CODE TO PAY-DTL-COMPANY-CODE
033400     MOVE HV-PAYMENT-METHOD TO PAY-DTL-METHOD
033500     MOVE HV-AMOUNT TO PAY-DTL-AMOUNT
