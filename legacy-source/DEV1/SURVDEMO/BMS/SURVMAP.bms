000100 SURVMAP DFHMSD TYPE=&SYSPARM,MODE=INOUT,LANG=COBOL,             X
000200                TIOAPFX=YES,STORAGE=AUTO,CTRL=(FREEKB,FRSET)
000300 SURVSCR DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
000400          DFHMDF POS=(1,18),LENGTH=44,ATTRB=(ASKIP,BRT),          X
000500                INITIAL='SURVIVOR INCOME BENEFIT INQUIRY'
000600          DFHMDF POS=(3,2),LENGTH=9,ATTRB=(ASKIP),               X
000700                INITIAL='CLAIM ID:'
000800 CLAIMID  DFHMDF POS=(3,14),LENGTH=12,ATTRB=(UNPROT,IC,FSET)
000900          DFHMDF POS=(4,2),LENGTH=15,ATTRB=(ASKIP),              X
001000                INITIAL='BENEFICIARY ID:'
001100 BENEID   DFHMDF POS=(4,19),LENGTH=10,ATTRB=(UNPROT,FSET)
001200          DFHMDF POS=(6,2),LENGTH=17,ATTRB=(ASKIP),              X
001300                INITIAL='BENEFICIARY NAME:'
001400 BENENM   DFHMDF POS=(6,21),LENGTH=30,ATTRB=(ASKIP)
001500          DFHMDF POS=(8,2),LENGTH=13,ATTRB=(ASKIP),              X
001600                INITIAL='RELATIONSHIP:'
001700 RELATION DFHMDF POS=(8,21),LENGTH=10,ATTRB=(ASKIP)
001800          DFHMDF POS=(10,2),LENGTH=15,ATTRB=(ASKIP),             X
001900                INITIAL='MONTHLY AMOUNT:'
002000 MONTHAMT DFHMDF POS=(10,21),LENGTH=15,ATTRB=(ASKIP)
002100          DFHMDF POS=(12,2),LENGTH=11,ATTRB=(ASKIP),             X
002200                INITIAL='START DATE:'
002300 STARTDT  DFHMDF POS=(12,21),LENGTH=10,ATTRB=(ASKIP)
002400          DFHMDF POS=(13,2),LENGTH=9,ATTRB=(ASKIP),              X
002500                INITIAL='END DATE:'
002600 ENDDT    DFHMDF POS=(13,21),LENGTH=10,ATTRB=(ASKIP)
002700          DFHMDF POS=(15,2),LENGTH=7,ATTRB=(ASKIP),              X
002800                INITIAL='STATUS:'
002900 STATUS   DFHMDF POS=(15,21),LENGTH=12,ATTRB=(ASKIP)
003000 MESSAGE  DFHMDF POS=(20,2),LENGTH=60,ATTRB=(ASKIP,BRT)
003100          DFHMDF POS=(23,2),LENGTH=28,ATTRB=(ASKIP),             X
003200                INITIAL='ENTER=INQUIRE  PF3=EXIT'
003300          DFHMSD TYPE=FINAL
003400          END
