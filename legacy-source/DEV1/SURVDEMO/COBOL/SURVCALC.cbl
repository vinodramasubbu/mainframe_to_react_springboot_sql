028200               :HV-BENEFICIARY-STATUS,
028300               :HV-BENEFIT-PCT,
028400               :HV-OTHER-INCOME-OFFSET,
028500               :HV-TOTAL-PAID,
028600               :HV-VERSION-NO,
028700               :HV-START-DATE,
028800               :HV-END-DATE :HV-END-DATE-IND
028900     END-EXEC
