017900     END-IF
018000
018100     EXEC SQL COMMIT END-EXEC
018200     IF SQLCODE NOT = ZERO
018300         PERFORM SET-TECHNICAL-FAILURE
018400         GO TO ROLLBACK-RUN
018500     END-IF
018600     GO TO FINISH-PROGRAM.
