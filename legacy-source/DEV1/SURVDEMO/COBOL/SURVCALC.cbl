019600     EXEC SQL COMMIT END-EXEC
019700     MOVE 12 TO WS-MAX-RC.
019800
019900 FINISH-PROGRAM.
020000     PERFORM CLOSE-FILES
020100     DISPLAY 'SURVCALC RUN=' HV-RUN-ID
020200             ' PAYMENTS=' WS-PAYMENT-COUNT
020300             ' EXCEPTIONS=' WS-EXCEPTION-COUNT
020400     MOVE WS-MAX-RC TO RETURN-CODE
