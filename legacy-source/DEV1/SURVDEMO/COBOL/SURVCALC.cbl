010100     EXEC SQL
010200         DECLARE SURVCUR CURSOR FOR
010300         SELECT P.POLICY_ID,
010400                P.BASE_MONTHLY_BENEFIT,
010500                P.FAMILY_MAX_PCT,
010600                C.CLAIM_ID,
010700                C.CLAIM_STATUS,
010800                B.BENEFICIARY_ID,
010900                B.BENEFICIARY_NAME,
011000                B.RELATIONSHIP,
011100                B.STATUS,
011200                E.BENEFIT_PCT,
011300                E.OTHER_INCOME_OFFSET,
011400                E.TOTAL_PAID,
011500                E.VERSION_NO,
011600                CHAR(E.START_DATE, ISO),
011700                CHAR(E.END_DATE, ISO)
011800           FROM SURVDEMO.POLICY P
011900           JOIN SURVDEMO.SURVIVOR_CLAIM C
012000             ON C.POLICY_ID = P.POLICY_ID
012100           JOIN SURVDEMO.SURVIVOR_ENTITLEMENT E
012200             ON E.CLAIM_ID = C.CLAIM_ID
012300           JOIN SURVDEMO.BENEFICIARY B
012400             ON B.BENEFICIARY_ID = E.BENEFICIARY_ID
012500          WHERE P.STATUS = 'A'
012600            AND C.CLAIM_STATUS = 'A'
012700            AND E.STATUS = 'A'
012800            AND E.START_DATE <= DATE(:HV-RUN-DATE)
012900            AND (E.END_DATE IS NULL
013000                 OR E.END_DATE >= DATE(:HV-RUN-DATE))
013100          ORDER BY C.CLAIM_ID, B.BENEFICIARY_ID
013200          WITH RS USE AND KEEP UPDATE LOCKS
013300     END-EXEC.
013400
013500 PROCEDURE DIVISION.
