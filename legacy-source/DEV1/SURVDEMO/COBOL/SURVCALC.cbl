029900 PROCESS-ENTITLEMENT.
030000     IF HV-CLAIM-ID NOT = WS-CURRENT-CLAIM
030100         MOVE HV-CLAIM-ID TO WS-CURRENT-CLAIM
030200         MOVE ZERO TO WS-FAMILY-TOTAL
030300         COMPUTE WS-FAMILY-CAP ROUNDED =
030400             HV-BASE-MONTHLY-BENEFIT
030500           * HV-FAMILY-MAX-PCT / 100
030600     END-IF
030700
030800     PERFORM VALIDATE-ENTITLEMENT
030900     IF SV-INVALID
031000         MOVE SV-REASON-CODE TO WS-EXCEPTION-CODE
031100         MOVE ZERO TO WS-GROSS-AMOUNT WS-NET-AMOUNT
031200         PERFORM WRITE-BUSINESS-EXCEPTION
031300         EXIT PARAGRAPH
031400     END-IF
031500
031600     PERFORM CHECK-DUPLICATE
031610     IF WS-FATAL
031620         EXIT PARAGRAPH
031630     END-IF
031700     IF WS-EXCEPTION-CODE NOT = SPACES
031800         PERFORM WRITE-BUSINESS-EXCEPTION
031900         EXIT PARAGRAPH
032000     END-IF
032100
032200     COMPUTE WS-GROSS-AMOUNT ROUNDED =
032300         HV-BASE-MONTHLY-BENEFIT * HV-BENEFIT-PCT / 100
032400     COMPUTE WS-NET-AMOUNT =
032500         WS-GROSS-AMOUNT - HV-OTHER-INCOME-OFFSET
032600
032700     IF WS-NET-AMOUNT <= ZERO
032800         MOVE 'Z1' TO WS-EXCEPTION-CODE
032900         PERFORM WRITE-BUSINESS-EXCEPTION
033000         EXIT PARAGRAPH
033100     END-IF
033200
033300     MOVE 'R' TO WS-PAYMENT-STATUS
