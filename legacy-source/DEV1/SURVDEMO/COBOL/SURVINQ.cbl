000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. SURVINQ.
000300 AUTHOR. SURVDEMO.
000400*
000500* CICS PSEUDO-CONVERSATIONAL SURVIVOR BENEFIT INQUIRY.
000600*
000700 DATA DIVISION.
000800 WORKING-STORAGE SECTION.
000900 01  WS-RESP                     PIC S9(8) COMP VALUE ZERO.
001000 01  WS-RESP2                    PIC S9(8) COMP VALUE ZERO.
001100 01  WS-CLAIM-ID                 PIC X(12).
001200 01  WS-BENEFICIARY-ID           PIC X(10).
001300 01  WS-RELATIONSHIP-TEXT        PIC X(10).
001400 01  WS-STATUS-TEXT              PIC X(12).
001500 01  WS-MESSAGE                  PIC X(60).
001600 01  WS-AMOUNT-EDIT              PIC -ZZZ,ZZZ,ZZ9.99.
001700
001800     COPY DFHAID.
001900     COPY SURVMAP.
002000     COPY SURVCOM.
002100
002200     EXEC SQL BEGIN DECLARE SECTION END-EXEC.
002300     COPY SURVHOST.
002400     EXEC SQL END DECLARE SECTION END-EXEC.
002500     EXEC SQL INCLUDE SQLCA END-EXEC.
002600
002700 LINKAGE SECTION.
002800 01  DFHCOMMAREA                 PIC X(32).
002900
003000 PROCEDURE DIVISION.
003100 MAIN-LOGIC.
003200     IF EIBCALEN = ZERO
003300         INITIALIZE SURVIVOR-INQUIRY-COMMAREA
003400         SET SI-FIRST-SEND TO TRUE
003500         MOVE EIBUSERID TO SI-USER-ID
003600         PERFORM SEND-EMPTY-MAP
003700         SET SI-WAITING-INPUT TO TRUE
003800         PERFORM RETURN-TO-CICS
003900     END-IF
004000
004100     MOVE DFHCOMMAREA TO SURVIVOR-INQUIRY-COMMAREA
004200     INITIALIZE SURVSCRI SURVSCRO
004210     INITIALIZE SURVIVOR-HOST-VARIABLES
004220     MOVE SPACES TO WS-RELATIONSHIP-TEXT WS-STATUS-TEXT
004230     MOVE ZERO TO WS-AMOUNT-EDIT
004240     MOVE -1 TO HV-END-DATE-IND
004300
004400     EXEC CICS RECEIVE
004500          MAP('SURVSCR')
004600          MAPSET('SURVMAP')
004700          INTO(SURVSCRI)
004800          RESP(WS-RESP)
004900          RESP2(WS-RESP2)
005000     END-EXEC
005100
005200     IF EIBAID = DFHPF3
005300         EXEC CICS RETURN END-EXEC
005400     END-IF
005500
005600     IF WS-RESP = DFHRESP(MAPFAIL)
005700         MOVE 'ENTER CLAIM AND BENEFICIARY IDS' TO WS-MESSAGE
005800         PERFORM SEND-RESULT-MAP
005900         PERFORM RETURN-TO-CICS
006000     END-IF
006100
006200     MOVE CLAIMIDI TO WS-CLAIM-ID
006300     MOVE BENEIDI TO WS-BENEFICIARY-ID
006400
006500     EVALUATE TRUE
006600         WHEN WS-CLAIM-ID = SPACES
006700             MOVE 'CLAIM ID IS REQUIRED' TO WS-MESSAGE
006800             PERFORM SEND-RESULT-MAP
006900             PERFORM RETURN-TO-CICS
007000         WHEN WS-BENEFICIARY-ID = SPACES
007100             MOVE 'BENEFICIARY ID IS REQUIRED' TO WS-MESSAGE
007200             PERFORM SEND-RESULT-MAP
007300             PERFORM RETURN-TO-CICS
007400         WHEN OTHER
007500             CONTINUE
007600     END-EVALUATE
007700
007800     MOVE WS-CLAIM-ID TO HV-CLAIM-ID
007900     MOVE WS-BENEFICIARY-ID TO HV-BENEFICIARY-ID
008000     MOVE -1 TO HV-END-DATE-IND
008100
008200     EXEC SQL
008300         SELECT B.BENEFICIARY_NAME,
008400                B.RELATIONSHIP,
008500                B.STATUS,
008600                C.CLAIM_STATUS,
008700                E.STATUS,
008800                E.MONTHLY_AMOUNT,
008900                CHAR(E.START_DATE, ISO),
009000                CHAR(E.END_DATE, ISO)
009100           INTO :HV-BENEFICIARY-NAME,
009200                :HV-RELATIONSHIP,
009300                :HV-BENEFICIARY-STATUS,
009400                :HV-CLAIM-STATUS,
009500                :HV-ENTITLEMENT-STATUS,
009600                :HV-MONTHLY-AMOUNT,
009700                :HV-START-DATE,
009800                :HV-END-DATE :HV-END-DATE-IND
009900           FROM SURVDEMO.SURVIVOR_CLAIM C
010000           JOIN SURVDEMO.SURVIVOR_ENTITLEMENT E
010100             ON E.CLAIM_ID = C.CLAIM_ID
010200           JOIN SURVDEMO.BENEFICIARY B
010300             ON B.BENEFICIARY_ID = E.BENEFICIARY_ID
010400          WHERE C.CLAIM_ID = :HV-CLAIM-ID
010500            AND E.BENEFICIARY_ID = :HV-BENEFICIARY-ID
010600          WITH CS
010700     END-EXEC
010800
010900     EVALUATE SQLCODE
011000         WHEN ZERO
011100             PERFORM FORMAT-RESULT
011200         WHEN +100
011300             MOVE 'ENTITLEMENT NOT FOUND' TO WS-MESSAGE
011400         WHEN OTHER
011500             MOVE 'BENEFIT SERVICE UNAVAILABLE' TO WS-MESSAGE
011600     END-EVALUATE
011700
011800     PERFORM SEND-RESULT-MAP
011900     PERFORM RETURN-TO-CICS.
012000
012100 FORMAT-RESULT.
012200     EVALUATE HV-RELATIONSHIP
012300         WHEN 'SPS'
012400             MOVE 'SPOUSE' TO WS-RELATIONSHIP-TEXT
012500         WHEN 'CHD'
012600             MOVE 'CHILD' TO WS-RELATIONSHIP-TEXT
012700         WHEN 'DEP'
012800             MOVE 'DEPENDENT' TO WS-RELATIONSHIP-TEXT
012900         WHEN OTHER
013000             MOVE 'UNKNOWN' TO WS-RELATIONSHIP-TEXT
013100     END-EVALUATE
013200
013300     EVALUATE TRUE
013400         WHEN HV-CLAIM-STATUS NOT = 'A'
013500             MOVE 'NOT APPROVED' TO WS-STATUS-TEXT
013600             MOVE 'CLAIM IS NOT APPROVED' TO WS-MESSAGE
013700         WHEN HV-BENEFICIARY-STATUS NOT = 'A'
013800             MOVE 'INELIGIBLE' TO WS-STATUS-TEXT
013900             MOVE 'BENEFICIARY IS NOT ELIGIBLE' TO WS-MESSAGE
014000         WHEN HV-ENTITLEMENT-STATUS = 'A'
014100             MOVE 'ACTIVE' TO WS-STATUS-TEXT
014200             MOVE 'ENTITLEMENT FOUND' TO WS-MESSAGE
014300         WHEN HV-ENTITLEMENT-STATUS = 'S'
014400             MOVE 'SUSPENDED' TO WS-STATUS-TEXT
014500             MOVE 'ENTITLEMENT IS SUSPENDED' TO WS-MESSAGE
014600         WHEN HV-ENTITLEMENT-STATUS = 'E'
014700             MOVE 'ENDED' TO WS-STATUS-TEXT
014800             MOVE 'ENTITLEMENT HAS ENDED' TO WS-MESSAGE
014900         WHEN HV-ENTITLEMENT-STATUS = 'C'
015000             MOVE 'CANCELLED' TO WS-STATUS-TEXT
015100             MOVE 'ENTITLEMENT IS CANCELLED' TO WS-MESSAGE
015200         WHEN OTHER
015300             MOVE 'UNKNOWN' TO WS-STATUS-TEXT
015400             MOVE 'UNKNOWN ENTITLEMENT STATUS' TO WS-MESSAGE
015500     END-EVALUATE
015600
015700     MOVE HV-MONTHLY-AMOUNT TO WS-AMOUNT-EDIT.
015800
015900 SEND-EMPTY-MAP.
016000     INITIALIZE SURVSCRO
016100     MOVE 'ENTER CLAIM AND BENEFICIARY IDS' TO MESSAGEO
016200     EXEC CICS SEND
016300          MAP('SURVSCR')
016400          MAPSET('SURVMAP')
016500          FROM(SURVSCRO)
016600          ERASE
016700          RESP(WS-RESP)
016800     END-EXEC.
016900
017000 SEND-RESULT-MAP.
017100     MOVE WS-CLAIM-ID TO CLAIMIDO
017200     MOVE WS-BENEFICIARY-ID TO BENEIDO
017300     MOVE HV-BENEFICIARY-NAME(1:30) TO BENENMO
017400     MOVE WS-RELATIONSHIP-TEXT TO RELATIONO
017500     MOVE WS-AMOUNT-EDIT TO MONTHAMTO
017600     MOVE HV-START-DATE TO STARTDTO
017700     IF HV-END-DATE-IND < ZERO
017800         MOVE SPACES TO ENDDTO
017900     ELSE
018000         MOVE HV-END-DATE TO ENDDTO
018100     END-IF
018200     MOVE WS-STATUS-TEXT TO STATUSO
018300     MOVE WS-MESSAGE TO MESSAGEO
018400     EXEC CICS SEND
018500          MAP('SURVSCR')
018600          MAPSET('SURVMAP')
018700          FROM(SURVSCRO)
018800          ERASE
018900          RESP(WS-RESP)
019000     END-EXEC.
019100
019200 RETURN-TO-CICS.
019300     MOVE WS-CLAIM-ID TO SI-LAST-CLAIM-ID
019400     MOVE WS-BENEFICIARY-ID TO SI-LAST-BENEFICIARY-ID
019500     SET SI-WAITING-INPUT TO TRUE
019600     EXEC CICS RETURN
019700          TRANSID('SI01')
019800          COMMAREA(SURVIVOR-INQUIRY-COMMAREA)
019900          LENGTH(LENGTH OF SURVIVOR-INQUIRY-COMMAREA)
020000     END-EXEC.
