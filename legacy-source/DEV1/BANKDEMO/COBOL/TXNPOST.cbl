011400 PROCEDURE DIVISION.
011500 MAIN-LOGIC.
011600     PERFORM OPEN-FILES
011700     IF WS-FATAL
011800         GO TO FINISH-PROGRAM
011900     END-IF
012000
012100     PERFORM UNTIL WS-END-OF-FILE OR WS-FATAL
012200         READ TXN-IN
012300             AT END
012400                 SET WS-END-OF-FILE TO TRUE
012500             NOT AT END
012600                 ADD 1 TO WS-READ-COUNT
012700                 PERFORM PROCESS-TRANSACTION
012800                 ADD 1 TO WS-SINCE-COMMIT
012900                 IF WS-SINCE-COMMIT >= WS-COMMIT-LIMIT
013000                     PERFORM COMMIT-WORK
013100                 END-IF
013200         END-READ
013300     END-PERFORM
013400
013500     IF WS-FATAL
013600         PERFORM PRESERVE-PRIOR-WORK
013700     ELSE
013800         PERFORM COMMIT-WORK
013900     END-IF
014000
014100 FINISH-PROGRAM.
014200     PERFORM CLOSE-FILES
014300     DISPLAY 'TXNPOST READ=' WS-READ-COUNT
014400             ' ACCEPTED=' WS-ACCEPT-COUNT
014500             ' REJECTED=' WS-REJECT-COUNT
014600     MOVE WS-MAX-RC TO RETURN-CODE
014700     GOBACK.
014800
014900 OPEN-FILES.
015000     OPEN INPUT TXN-IN
015100          OUTPUT AUDIT-OUT REJECT-OUT
015200     IF WS-TXN-FILE-STATUS NOT = '00'
015300        OR WS-AUDIT-FILE-STATUS NOT = '00'
015400        OR WS-REJECT-FILE-STATUS NOT = '00'
015500         MOVE 12 TO WS-MAX-RC
015600         SET WS-FATAL TO TRUE
015700     END-IF.
015800
015900 CLOSE-FILES.
016000     CLOSE TXN-IN AUDIT-OUT REJECT-OUT.
016100
016200 PROCESS-TRANSACTION.
016300     MOVE TXN-INPUT-RECORD TO TV-TRANSACTION
016400     CALL WS-VALIDATOR-PGM USING TXN-VALIDATION-AREA
016500
016600     IF TV-RESULT-INVALID
016700         MOVE TV-REASON-CODE TO WS-REASON-CODE
016800         PERFORM WRITE-REJECT
016900         EXIT PARAGRAPH
017000     END-IF
017100
017200     MOVE 'N' TO WS-SAVEPOINT-SW
017300     EXEC SQL
017400         SAVEPOINT TXN_UNIT ON ROLLBACK RETAIN CURSORS
017500     END-EXEC
017600     IF SQLCODE NOT = ZERO
017700         MOVE '90' TO WS-REASON-CODE
017800         PERFORM HANDLE-TECHNICAL-FAILURE
017900         EXIT PARAGRAPH
018000     END-IF
018100     SET WS-SAVEPOINT-SET TO TRUE
018200
018300     MOVE TV-TXN-ID TO HV-TXN-ID
018400     MOVE TV-TXN-TYPE TO HV-TXN-TYPE
018500     MOVE TV-TXN-AMOUNT TO HV-TXN-AMOUNT
018600     MOVE TV-REFERENCE TO HV-SOURCE-REF
018700     STRING
018800         TV-TXN-DATE(1:4) DELIMITED BY SIZE
018900         '-' DELIMITED BY SIZE
019000         TV-TXN-DATE(5:2) DELIMITED BY SIZE
019100         '-' DELIMITED BY SIZE
019200         TV-TXN-DATE(7:2) DELIMITED BY SIZE
019300         INTO HV-TXN-DATE
019400     END-STRING
019500
019600     EXEC SQL
019700         SELECT COUNT(*)
019800           INTO :HV-DUP-COUNT
019900           FROM BANKDEMO.ACCOUNT_TXN
020000          WHERE TXN_ID = :HV-TXN-ID
020100          WITH CS
020200     END-EXEC
020300     IF SQLCODE NOT = ZERO
020400         MOVE '90' TO WS-REASON-CODE
020500         PERFORM HANDLE-TECHNICAL-FAILURE
020600         EXIT PARAGRAPH
020700     END-IF
020800     IF HV-DUP-COUNT > ZERO
020900         MOVE '06' TO WS-REASON-CODE
021000         PERFORM WRITE-REJECT
021100         EXIT PARAGRAPH
021200     END-IF
021300
021400     MOVE TV-ACCOUNT-ID TO HV-ACCOUNT-ID
021500     EXEC SQL
021600         SELECT CUSTOMER_ID,
021700                ACCOUNT_TYPE,
021800                STATUS,
021900                BALANCE,
022000                OVERDRAFT_LIMIT,
022100                CHAR(LAST_TXN_DATE, ISO)
022200           INTO :HV-CUSTOMER-ID,
022300                :HV-ACCOUNT-TYPE,
022400                :HV-ACCOUNT-STATUS,
022500                :HV-BALANCE,
022600                :HV-OVERDRAFT-LIMIT,
022700                :HV-LAST-TXN-DATE
022710                 :HV-LAST-TXN-DATE-IND
022800           FROM BANKDEMO.ACCOUNT
022900          WHERE ACCOUNT_ID = :HV-ACCOUNT-ID
023000          WITH RS USE AND KEEP UPDATE LOCKS
023100     END-EXEC
023200
023300     IF SQLCODE = +100
023400         MOVE '07' TO WS-REASON-CODE
023500         PERFORM WRITE-REJECT
023600         EXIT PARAGRAPH
023700     END-IF
023800     IF SQLCODE NOT = ZERO
023900         MOVE '90' TO WS-REASON-CODE
024000         PERFORM HANDLE-TECHNICAL-FAILURE
024100         EXIT PARAGRAPH
024200     END-IF
024300
024400     IF NOT HV-ACCOUNT-ACTIVE
024500         MOVE '08' TO WS-REASON-CODE
024600         PERFORM WRITE-REJECT
024700         EXIT PARAGRAPH
024800     END-IF
024900
025000     MOVE ZERO TO HV-FEE-AMOUNT
025100     IF HV-TXN-TYPE = 'C'
025200         ADD HV-TXN-AMOUNT TO HV-BALANCE
025300     ELSE
025400         COMPUTE WS-PROJECTED-BALANCE =
025500             HV-BALANCE - HV-TXN-AMOUNT
025600         IF WS-PROJECTED-BALANCE < ZERO
025700            AND HV-BALANCE >= ZERO
025800             MOVE 35 TO HV-FEE-AMOUNT
025900         END-IF
026000         COMPUTE WS-TOTAL-DEBIT =
026100             HV-TXN-AMOUNT + HV-FEE-AMOUNT
026200         COMPUTE WS-AVAILABLE-BALANCE =
026300             HV-BALANCE + HV-OVERDRAFT-LIMIT
026400         IF WS-TOTAL-DEBIT > WS-AVAILABLE-BALANCE
026500             MOVE '09' TO WS-REASON-CODE
026600             PERFORM WRITE-REJECT
026700             EXIT PARAGRAPH
026800         END-IF
026900         SUBTRACT WS-TOTAL-DEBIT FROM HV-BALANCE
027000     END-IF
027100
027200     EXEC SQL
027300         UPDATE BANKDEMO.ACCOUNT
027400            SET BALANCE = :HV-BALANCE,
027500                LAST_TXN_DATE = DATE(:HV-TXN-DATE),
027600                UPDATED_TS = CURRENT TIMESTAMP
027700          WHERE ACCOUNT_ID = :HV-ACCOUNT-ID
027800     END-EXEC
027900     IF SQLCODE NOT = ZERO
028000         MOVE '90' TO WS-REASON-CODE
028100         PERFORM HANDLE-TECHNICAL-FAILURE
028200         EXIT PARAGRAPH
028300     END-IF
028400
028500     EXEC SQL
028600         INSERT INTO BANKDEMO.ACCOUNT_TXN
028700             (TXN_ID, ACCOUNT_ID, TXN_DATE, TXN_TYPE,
028800              AMOUNT, FEE_AMOUNT, BALANCE_AFTER,
028900              SOURCE_REF, POSTED_TS)
029000         VALUES
029100             (:HV-TXN-ID, :HV-ACCOUNT-ID, DATE(:HV-TXN-DATE),
029200              :HV-TXN-TYPE, :HV-TXN-AMOUNT, :HV-FEE-AMOUNT,
029300              :HV-BALANCE, :HV-SOURCE-REF, CURRENT TIMESTAMP)
029400     END-EXEC
029500     IF SQLCODE NOT = ZERO
029600         MOVE '90' TO WS-REASON-CODE
029700         PERFORM HANDLE-TECHNICAL-FAILURE
029800         EXIT PARAGRAPH
029900     END-IF
030000
030100     PERFORM WRITE-AUDIT
030200     ADD 1 TO WS-ACCEPT-COUNT.
030300
030400 WRITE-AUDIT.
030500     MOVE HV-TXN-ID TO AO-TXN-ID
030600     MOVE HV-ACCOUNT-ID TO AO-ACCOUNT-ID
030700     MOVE HV-TXN-TYPE TO AO-TXN-TYPE
030800     MOVE HV-TXN-AMOUNT TO AO-AMOUNT
030900     MOVE HV-FEE-AMOUNT TO AO-FEE
031000     MOVE '00' TO AO-CODE
031050     MOVE HV-SOURCE-REF TO AO-REFERENCE
031060     MOVE 'DLY001' TO AO-BATCH-ID
031100     IF HV-BALANCE < ZERO
031200         MOVE '-' TO AO-BALANCE-SIGN
031300         COMPUTE AO-BALANCE = HV-BALANCE * -1
031400     ELSE
031500         MOVE '+' TO AO-BALANCE-SIGN
031600         MOVE HV-BALANCE TO AO-BALANCE
031700     END-IF
031800     WRITE AUDIT-FILE-RECORD FROM WS-AUDIT-RECORD.
031900
032000 WRITE-REJECT.
032100     PERFORM FORMAT-REASON
032200     MOVE TXN-ID TO RO-TXN-ID
032300     MOVE TXN-ACCOUNT-ID TO RO-ACCOUNT-ID
032400     MOVE WS-REASON-CODE TO RO-REASON-CODE
032500     MOVE TXN-REFERENCE TO RO-REFERENCE
032600     MOVE WS-REASON-TEXT TO RO-REASON-TEXT
032700     WRITE REJECT-FILE-RECORD FROM WS-REJECT-RECORD
032800     ADD 1 TO WS-REJECT-COUNT
032900     IF WS-MAX-RC < 4
033000         MOVE 4 TO WS-MAX-RC
033100     END-IF.
033200
033300 FORMAT-REASON.
033400     EVALUATE WS-REASON-CODE
033500         WHEN '01'
033600             MOVE 'TRANSACTION ID REQUIRED' TO WS-REASON-TEXT
033700         WHEN '02'
033800             MOVE 'ACCOUNT ID REQUIRED' TO WS-REASON-TEXT
033900         WHEN '03'
034000             MOVE 'INVALID DATE' TO WS-REASON-TEXT
034100         WHEN '04'
034200             MOVE 'INVALID TRANSACTION TYPE' TO WS-REASON-TEXT
034300         WHEN '05'
034400             MOVE 'INVALID AMOUNT' TO WS-REASON-TEXT
034500         WHEN '06'
034600             MOVE 'DUPLICATE TRANSACTION' TO WS-REASON-TEXT
034700         WHEN '07'
034800             MOVE 'ACCOUNT NOT FOUND' TO WS-REASON-TEXT
034900         WHEN '08'
035000             MOVE 'ACCOUNT NOT ACTIVE' TO WS-REASON-TEXT
035100         WHEN '09'
035200             MOVE 'INSUFFICIENT FUNDS' TO WS-REASON-TEXT
035300         WHEN OTHER
035400             MOVE 'TECHNICAL DATABASE FAILURE' TO WS-REASON-TEXT
035500     END-EVALUATE.
035600
035700 HANDLE-TECHNICAL-FAILURE.
035800     PERFORM WRITE-REJECT
035900     MOVE 12 TO WS-MAX-RC
036000     SET WS-FATAL TO TRUE.
036100
036200 COMMIT-WORK.
036300     EXEC SQL COMMIT END-EXEC
036400     IF SQLCODE NOT = ZERO
036500         MOVE 12 TO WS-MAX-RC
036600         SET WS-FATAL TO TRUE
036700     ELSE
036800         MOVE ZERO TO WS-SINCE-COMMIT
036900     END-IF.
037000
037100 PRESERVE-PRIOR-WORK.
037200     IF WS-SAVEPOINT-SET
037300         EXEC SQL
037400             ROLLBACK TO SAVEPOINT TXN_UNIT
037500         END-EXEC
037600     END-IF
037700     EXEC SQL COMMIT END-EXEC
037800     IF SQLCODE NOT = ZERO
037900         EXEC SQL ROLLBACK END-EXEC
038000     END-IF.
