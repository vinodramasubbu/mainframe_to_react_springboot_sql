000100 IDENTIFICATION DIVISION.
000200 PROGRAM-ID. ACCTINQ.
000300 AUTHOR. BANKDEMO.
000400*
000500* CICS PSEUDO-CONVERSATIONAL ACCOUNT INQUIRY.
000600*
000700 DATA DIVISION.
000800 WORKING-STORAGE SECTION.
000900 01  WS-RESP                    PIC S9(8) COMP VALUE ZERO.
001000 01  WS-RESP2                   PIC S9(8) COMP VALUE ZERO.
001100 01  WS-CUSTOMER-NAME           PIC X(60).
001200 01  WS-BALANCE-EDIT            PIC -ZZZ,ZZZ,ZZ9.99.
001300 01  WS-STATUS-TEXT             PIC X(10).
001400 01  WS-MESSAGE                 PIC X(60).
001500 01  WS-ACCOUNT-ID              PIC X(10).
001600
001700     COPY DFHAID.
001800     COPY ACCTMAP.
001900     COPY INQCOM.
002000     EXEC SQL BEGIN DECLARE SECTION END-EXEC.
002100     COPY ACCTREC.
002200     EXEC SQL END DECLARE SECTION END-EXEC.
002300     EXEC SQL INCLUDE SQLCA END-EXEC.
002400
002500 LINKAGE SECTION.
002600 01  DFHCOMMAREA                PIC X(32).
002700
002800 PROCEDURE DIVISION.
002900 MAIN-LOGIC.
003000     IF EIBCALEN = ZERO
003100         INITIALIZE INQUIRY-COMMAREA
003200         SET INQ-FIRST-SEND TO TRUE
003300         MOVE EIBUSERID TO INQ-USER-ID
003400         PERFORM SEND-EMPTY-MAP
003500         SET INQ-WAITING-INPUT TO TRUE
003600         PERFORM RETURN-TO-CICS
003700     END-IF
003800
003900     MOVE DFHCOMMAREA TO INQUIRY-COMMAREA
004000     INITIALIZE ACCTSCRI ACCTSCRO
004100
004200     EXEC CICS RECEIVE
004300          MAP('ACCTSCR')
004400          MAPSET('ACCTMAP')
004500          INTO(ACCTSCRI)
004600          RESP(WS-RESP)
004700          RESP2(WS-RESP2)
004800     END-EXEC
004900
005000     IF EIBAID = DFHPF3
005100         EXEC CICS RETURN END-EXEC
005200     END-IF
005300
005400     IF WS-RESP = DFHRESP(MAPFAIL)
005500         MOVE 'ENTER AN ACCOUNT ID' TO WS-MESSAGE
005600         PERFORM SEND-RESULT-MAP
005700         PERFORM RETURN-TO-CICS
005800     END-IF
005900
006000     MOVE ACCTIDI TO WS-ACCOUNT-ID
006100     IF WS-ACCOUNT-ID = SPACES
006200         MOVE 'ACCOUNT ID IS REQUIRED' TO WS-MESSAGE
006300         PERFORM SEND-RESULT-MAP
006400         PERFORM RETURN-TO-CICS
006500     END-IF
006600
006700     MOVE WS-ACCOUNT-ID TO HV-ACCOUNT-ID
006800     EXEC SQL
006900         SELECT A.CUSTOMER_ID,
007000                C.CUSTOMER_NAME,
007100                A.ACCOUNT_TYPE,
007200                A.STATUS,
007300                A.BALANCE,
007400                A.OVERDRAFT_LIMIT,
007500                CHAR(A.LAST_TXN_DATE, ISO)
007600           INTO :HV-CUSTOMER-ID,
007700                :WS-CUSTOMER-NAME,
007800                :HV-ACCOUNT-TYPE,
007900                :HV-ACCOUNT-STATUS,
008000                :HV-BALANCE,
008100                :HV-OVERDRAFT-LIMIT,
008200                :HV-LAST-TXN-DATE
008210                 :HV-LAST-TXN-DATE-IND
008300           FROM BANKDEMO.ACCOUNT A
008400           JOIN BANKDEMO.CUSTOMER C
008500             ON C.CUSTOMER_ID = A.CUSTOMER_ID
008600          WHERE A.ACCOUNT_ID = :HV-ACCOUNT-ID
008700          WITH CS
008800     END-EXEC
008900
009000     EVALUATE SQLCODE
009100         WHEN ZERO
009200             PERFORM FORMAT-ACCOUNT
009300         WHEN +100
009400             MOVE 'ACCOUNT NOT FOUND' TO WS-MESSAGE
009500         WHEN OTHER
009600             MOVE 'ACCOUNT SERVICE UNAVAILABLE' TO WS-MESSAGE
009700     END-EVALUATE
009800
009900     PERFORM SEND-RESULT-MAP
010000     PERFORM RETURN-TO-CICS.
010100
010200 FORMAT-ACCOUNT.
010300     MOVE HV-BALANCE TO WS-BALANCE-EDIT
010400     EVALUATE HV-ACCOUNT-STATUS
010500         WHEN 'A'
010600             MOVE 'ACTIVE' TO WS-STATUS-TEXT
010700         WHEN 'H'
010800             MOVE 'ON HOLD' TO WS-STATUS-TEXT
010900         WHEN 'C'
011000             MOVE 'CLOSED' TO WS-STATUS-TEXT
011100         WHEN OTHER
011200             MOVE 'UNKNOWN' TO WS-STATUS-TEXT
011300     END-EVALUATE
011400     MOVE 'ACCOUNT FOUND' TO WS-MESSAGE.
011500
011600 SEND-EMPTY-MAP.
011700     INITIALIZE ACCTSCRO
011800     MOVE 'ENTER AN ACCOUNT ID' TO MESSAGEO
011900     EXEC CICS SEND
012000          MAP('ACCTSCR')
012100          MAPSET('ACCTMAP')
012200          FROM(ACCTSCRO)
012300          ERASE
012400          RESP(WS-RESP)
012500     END-EXEC.
012600
012700 SEND-RESULT-MAP.
012800     MOVE WS-ACCOUNT-ID TO ACCTIDO
012900     MOVE WS-CUSTOMER-NAME(1:30) TO CUSTNMO
013000     MOVE HV-ACCOUNT-TYPE TO TYPEO
013100     MOVE WS-BALANCE-EDIT TO BALANCEO
013200     MOVE WS-STATUS-TEXT TO STATUSO
013300     MOVE WS-MESSAGE TO MESSAGEO
013400     EXEC CICS SEND
013500          MAP('ACCTSCR')
013600          MAPSET('ACCTMAP')
013700          FROM(ACCTSCRO)
013800          ERASE
013900          RESP(WS-RESP)
014000     END-EXEC.
014100
014200 RETURN-TO-CICS.
014300     MOVE WS-ACCOUNT-ID TO INQ-LAST-ACCOUNT-ID
014400     SET INQ-WAITING-INPUT TO TRUE
014500     EXEC CICS RETURN
014600          TRANSID('BA01')
014700          COMMAREA(INQUIRY-COMMAREA)
014800          LENGTH(LENGTH OF INQUIRY-COMMAREA)
014900     END-EXEC.
